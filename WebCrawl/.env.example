# WebCrawl Environment Configuration
# Copy this file to .env and fill in your actual API keys

# Tavily API Key (required)
# Get your free API key at: https://app.tavily.com
# Free tier: 1,000 API credits per month
TAVILY_API_KEY=your_tavily_api_key_here

# OpenAI API Key (required for embeddings)
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone API Key (required for vector storage)
# Get your API key at: https://app.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here

# Pinecone Index Configuration
# Index name for storing crawled content vectors
PINECONE_INDEX_NAME=webcrawl-index

# Optional: Pinecone Environment (if using legacy Pinecone)
# PINECONE_ENVIRONMENT=us-east-1-aws

# Optional: Custom API Rate Limits
# Adjust these if you have higher tier API plans
# TAVILY_RATE_LIMIT=100
# PINECONE_WRITE_LIMIT=50000

# Optional: Performance Tuning
# MAX_CONCURRENT_CRAWLS=5
# MAX_CONCURRENT_UPLOADS=10
# PINECONE_BATCH_SIZE=100